PORT=3000
# Use DATABASE_URL for hosted PostgreSQL. The provider's URL should include its TLS settings.
DATABASE_URL=
# These DB_* values are used for local PostgreSQL when DATABASE_URL is blank.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campus_benefit
DB_USER=postgres
DB_PASSWORD=YOUR_LOCAL_POSTGRES_PASSWORD
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Keep the Paystack key on the backend only. Replace with a test key first.
# Leave blank until the Campus Benefit Paystack account is ready.
PAYSTACK_SECRET_KEY=
APP_BASE_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=
# Local testing only: print reset links in the backend terminal instead of sending email.
PASSWORD_RESET_MODE=console
